#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_ray_tracing_position_fetch : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// (miojo) The game's own ambient occlusion, traced (vk_rt.cpp rt_ao_replace). OoT computes its occlusion at the start of a
// frame from the frame before's depth, at half size, into an R8 image (1: open); four blur passes of its own follow, and its
// lighting reads the result where it belongs, on the ambient light alone. This pass stands in for that first one (program
// 171c34b219c9c1a5): the same image written from rays into the scene's structure of the frame before, with that frame's
// camera and depth. So the occlusion is the game's in every way but where it comes from: blurred by the game, applied by
// the game, and not doubled, as a multiply over the finished picture was (rt_debug.comp's, which this replaces).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1) uniform sampler2D scene_depth;   // (the frame before's, full size)
layout(binding = 2, r8) uniform writeonly image2D occlusion;
layout(binding = 3) uniform sampler2D materials;   // (a texel a material's mean colour: vk_rt.cpp, as rt_debug.comp reads it)
layout(push_constant, row_major) uniform P {
    mat4 inv;       // (the frame before's clip space to the world)
    ivec2 size;     // (the occlusion image's)
    float strength; // (1: a ray's hit at no distance closes it whole)
    float radius;   // (how far a ray looks, in the world's units)
    float seed;
    int rays;
    float skin;     // (a character's own surface nearer than this does not occlude it: rt_debug.comp)
    float ambient;  // (the Traced ambient row, 0 to 1: how much the sky's reach shapes the game's ambient light)
    float far;      // (how far its rays look for the sky)
    float physical; // (the Path tracing row: the ambient light is what the rays bring, in the sky's units, no more the game's level shaped)
    vec4 to_sun;    // (the way to the game's sun or moon; w > 0: known)
    uint64_t light_list;   // (the game's lamps nearest the camera, 20 floats each: rt_debug.comp's list of the frame before)
    int light_count;
    float sky;      // (the sky's light as the picture has it, to weigh a lamp's against: a share of the sun's)
} pc;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats { float f[]; };
/// What of the light at pc.light_list's float o reaches the point p, no cosine: the game's own falloff, as rt_debug.comp's
/// light_fall has it
float lamp_fall(uint o, vec3 p) {
    Floats lb = Floats(pc.light_list);
    const vec4 at = vec4(lb.f[o], lb.f[o + 1u], lb.f[o + 2u], lb.f[o + 3u]);
    const float near = lb.f[o + 7u];
    const vec4 facing = vec4(lb.f[o + 8u], lb.f[o + 9u], lb.f[o + 10u], lb.f[o + 11u]);
    const vec3 to = at.xyz - p;
    const float d = length(to), x = d * at.w;
    if (!(x < 1.0 && d > 0.08)) return 0.0;
    const float x2 = x * x, reach = clamp(1.0 - x2 * x2, 0.0, 1.0);
    if (facing.w > 0.5) {
        const float inner = lb.f[o + 12u], outer = lb.f[o + 13u], c = dot(facing.xyz, -to) / d;
        const float cone = c > inner ? 1.0 : pow(clamp((c - outer) / max(inner - outer, 1e-4), 0.0, 1.0), lb.f[o + 14u]);
        const float nx = near > 0.0 ? clamp(d / near, 0.0, 1.0) : 1.0, nx2 = nx * nx;
        return cone * reach * reach * (near > 0.0 ? nx2 * nx2 * nx2 * (7.0 - 6.0 * nx) : 1.0) /
               max(lb.f[o + 18u] * d * d + lb.f[o + 17u] * d + lb.f[o + 16u], 1e-3);
    }
    const float past = max(d - near, 0.001);
    return reach / (past * past + 1.0);
}
vec3 world(vec2 uv, float d) {
    const vec4 p = pc.inv * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, d * 2.0 - 1.0, 1.0);
    return p.xyz / p.w;
}
vec3 surface(vec2 uv) { return world(uv, textureLod(scene_depth, uv, 0.0).r); }
// (white noise by pixel and ray: the game's blur after this takes it out; a gradient noise left diagonal streaks through it)
float noise(vec2 p) {
    uvec2 q = uvec2(ivec2(p * 8.0)) * uvec2(1597334673u, 3812015801u);
    uint n = (q.x ^ q.y) * 1597334673u;
    n ^= n >> 15, n *= 2246822519u, n ^= n >> 13;
    return float(n) * (1.0 / 4294967296.0);
}
/// A material's lightness, by an instance's number (vk_rt.cpp); 0.3 when not known
float lightness(int id) {
    const vec3 its = id == 0xfffffe || (id & 0xffff) < 2 ? vec3(0.0) : texelFetch(materials, ivec2(id & 255, (id >> 8) & 255), 0).rgb;
    return dot(its, vec3(1.0)) > 0.0 ? clamp(dot(its, vec3(0.2126, 0.7152, 0.0722)), 0.05, 0.9) : 0.3;
}
/// Whether nothing stands between p and len along d
bool reaches(vec3 p, vec3 d, float len) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF, p, 0.0, d, len);
    while (rayQueryProceedEXT(q)) {}
    return rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT;
}
/// The light straight from the sun and the lamps on a surface at p facing ng, the sky's own as 1 (the Path tracing row).
/// The sun: three skies at a surface square to it, less by the cosine, where a ray reaches it. A lamp: by the game's
/// falloff and the cosine, where a ray reaches it (stopped half a metre short: a lamp sits inside its housing).
/// ponytail: the sun three skies is a guess that lands the open air on the game's own level; a lamp under a hundredth
/// of the sky is not asked for
float direct(vec3 p, vec3 ng) {
    float e = 0.0;
    const float c = dot(ng, pc.to_sun.xyz);
    if (pc.to_sun.w > 0.0 && c > 0.0 && reaches(p, pc.to_sun.xyz, 400.0)) e = 3.0 * c;
    if (pc.sky > 0.0)
        for (int k = 0; k < pc.light_count; k++) {
            Floats lb = Floats(pc.light_list);
            const uint o = uint(k) * 20u;
            const vec3 to = vec3(lb.f[o], lb.f[o + 1u], lb.f[o + 2u]) - p;
            const float d = length(to);
            const float l = dot(vec3(lb.f[o + 4u], lb.f[o + 5u], lb.f[o + 6u]), vec3(0.2126, 0.7152, 0.0722)) * lamp_fall(o, p) *
                            max(dot(ng, to / max(d, 1e-4)), 0.0) / pc.sky;
            if (l > 0.01 && (d < 0.6 || reaches(p, to / d, d - 0.5))) e += l;
        }
    return e;
}
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, pc.size))) return;
    if (pc.rays < 0) {   // (a test, RX_VK_RT_AO_CONST: one value everywhere, to measure the game's ambient light by)
        imageStore(occlusion, g, vec4(pc.strength));
        return;
    }
    const vec2 uv = (vec2(g) + 0.5) / vec2(pc.size);
    const float d = textureLod(scene_depth, uv, 0.0).r;
    if (!(d > 0.0 && d < 1.0)) {   // (the sky)
        imageStore(occlusion, g, vec4(1.0));
        return;
    }
    const vec2 px = 1.0 / vec2(textureSize(scene_depth, 0));
    const vec3 p = world(uv, d), eye = world(uv, 0.0);
    // (the normal: on each axis the neighbour nearer in depth, so an edge does not bend it; towards the camera)
    const vec3 r = surface(uv + vec2(px.x, 0.0)) - p, l = p - surface(uv - vec2(px.x, 0.0));
    const vec3 u = surface(uv - vec2(0.0, px.y)) - p, dn = p - surface(uv + vec2(0.0, px.y));
    vec3 n = normalize(cross(dot(r, r) < dot(l, l) ? r : l, dot(u, u) < dot(dn, dn) ? u : dn));
    if (dot(n, eye - p) < 0.0) n = -n;
    // (what the rays have under the pixel. A character: its own layers within pc.skin are passed. Nothing within a few
    // centimetres: the surface seen is not where the rays have it. When a two-sided instance lies up to 0.4 in front (a
    // banner the wind swung back in its vertex shader, the rays having it as it hangs still) the rays start in front of
    // that copy: from behind it every one hit it at once, black patches over the banner, another shape each frame)
    float skip = 0.0, lift = 0.0;
    {
        rayQueryEXT q;
        rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, p + n * 0.03, 0.0, -n, 0.08);
        while (rayQueryProceedEXT(q)) {}
        if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            if (rayQueryGetIntersectionInstanceCustomIndexEXT(q, true) == 0xfffffe) skip = pc.skin;
        } else {
            rayQueryEXT far;
            rayQueryInitializeEXT(far, tlas, gl_RayFlagsOpaqueEXT, 0xFF, p + n * 0.4, 0.0, -n, 0.4);
            while (rayQueryProceedEXT(far)) {}
            if (rayQueryGetIntersectionTypeEXT(far, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                const int id = rayQueryGetIntersectionInstanceCustomIndexEXT(far, true);
                if (id != 0xfffffe && (id & 0x100000) != 0) lift = 0.4 - rayQueryGetIntersectionTEXT(far, true) + 0.02;
            }
        }
    }
    const vec3 t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0))), b = cross(n, t);
    const vec3 from = p + n * (0.004 * distance(eye, p) + 0.01 + lift);
    float sum = 0.0;
    for (int i = 0; i < pc.rays; i++) {
        const vec2 s = vec2(g) + pc.seed + float(i) * vec2(37.0, 17.0);
        const float a = 6.2831853 * noise(s), z2 = noise(s.yx + 11.0), rr = sqrt(1.0 - z2);
        const vec3 dir = t * (cos(a) * rr) + b * (sin(a) * rr) + n * sqrt(z2);
        rayQueryEXT q;
        rayQueryInitializeEXT(q, tlas, gl_RayFlagsCullBackFacingTrianglesEXT, 0xFF, from, 0.0, dir, pc.radius);
        while (rayQueryProceedEXT(q))
            if (rayQueryGetIntersectionTEXT(q, false) >= skip) rayQueryConfirmIntersectionEXT(q);
        if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
            sum += 1.0 - rayQueryGetIntersectionTEXT(q, true) / pc.radius;
    }
    // (the Traced ambient row. The game's ambient light is one level a place, set by hand, with this image over it: the
    // same under an open sky, under an eave, in an alley and a doorway. Long rays over the hemisphere, from where the
    // short ones end: one that leaves the scene has found the sky, one that is stopped brings what that wall gives back,
    // its material's lightness (0.3 when not known) times how lit it is: whole when a ray from it reaches the sun,
    // three tenths of that in its shadow, where only the sky lights it. Their mean scales this image, never under a
    // fifth, so the game lights by its own ambient, its colours and textures, as far as light reaches the place.
    // And lit by the game's lamps: each one's light at the wall by its own falloff, against the sky's (pc.sky), so a
    // room with a lantern keeps its ambient and a cave's lit corner too.
    // ponytail: the sky and the sun count the same, no ray from the wall to a lamp, and a cave's hand-set ambient is
    // not the sky's: where no lamp reaches it goes to that fifth)
    float wide = 1.0;
    if (pc.ambient > 0.0) {
        float open = 0.0;
        for (int i = 0; i < 6; i++) {
            const vec2 s = vec2(g) + pc.seed + float(i) * vec2(53.0, 29.0) + 101.0;
            const float a = 6.2831853 * noise(s), z2 = noise(s.yx + 11.0), rr = sqrt(1.0 - z2);
            const vec3 dir = t * (cos(a) * rr) + b * (sin(a) * rr) + n * sqrt(z2);
            rayQueryEXT q;
            rayQueryInitializeEXT(q, tlas, gl_RayFlagsCullBackFacingTrianglesEXT, 0xFF, from, pc.radius, dir, pc.far);
            while (rayQueryProceedEXT(q)) rayQueryConfirmIntersectionEXT(q);
            if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
                open += 1.0;
                continue;
            }
            const float light = lightness(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true));
            if (pc.physical > 0.5) {
                // (the Path tracing row: a path of two walls. At each the light straight on it, direct(), through the
                // lightness of every wall so far, then on by a ray over that wall's own hemisphere; a ray that leaves
                // the scene brings the sky. No floor and no light made up: what two walls do not bring is dark.
                // ponytail: two walls, a third's light is lost (a closed room reads darker than it is); and the result
                // cannot pass the game's own ambient level, which this image only scales)
                float through = 1.0;
                vec3 d = dir, o = from;
                for (int wall = 0;; wall++) {
                    vec3 v[3];
                    rayQueryGetIntersectionTriangleVertexPositionsEXT(q, true, v);
                    vec3 ng = normalize(mat3(rayQueryGetIntersectionObjectToWorldEXT(q, true)) * cross(v[1] - v[0], v[2] - v[0]));
                    if (dot(ng, d) > 0.0) ng = -ng;
                    o += d * rayQueryGetIntersectionTEXT(q, true) + ng * 0.03;
                    through *= wall == 0 ? light : lightness(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true));
                    open += through * direct(o, ng);
                    if (wall == 1) break;
                    const vec3 t2 = normalize(abs(ng.y) < 0.99 ? cross(ng, vec3(0.0, 1.0, 0.0)) : cross(ng, vec3(1.0, 0.0, 0.0))), b2 = cross(ng, t2);
                    const vec2 s2 = s + vec2(91.0, 53.0);
                    const float a2 = 6.2831853 * noise(s2), up = noise(s2.yx + 7.0), flat2 = sqrt(1.0 - up);
                    d = t2 * (cos(a2) * flat2) + b2 * (sin(a2) * flat2) + ng * sqrt(up);
                    rayQueryInitializeEXT(q, tlas, gl_RayFlagsCullBackFacingTrianglesEXT, 0xFF, o, 0.0, d, pc.far);
                    while (rayQueryProceedEXT(q)) rayQueryConfirmIntersectionEXT(q);
                    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
                        open += through;
                        break;
                    }
                }
                continue;
            }
            float lit = 0.3;
            if (pc.to_sun.w > 0.0 && reaches(from + dir * max(rayQueryGetIntersectionTEXT(q, true) - 0.05, 0.0), pc.to_sun.xyz, 400.0)) lit = 1.0;
            if (pc.sky > 0.0) {
                const vec3 hit = from + dir * rayQueryGetIntersectionTEXT(q, true);
                float lamps = 0.0;
                for (int k = 0; k < pc.light_count; k++) {
                    Floats lb = Floats(pc.light_list);
                    const uint o = uint(k) * 20u;
                    lamps += dot(vec3(lb.f[o + 4u], lb.f[o + 5u], lb.f[o + 6u]), vec3(0.2126, 0.7152, 0.0722)) * lamp_fall(o, hit);
                }
                lit = min(lit + lamps / pc.sky, 2.0);
            }
            open += light * lit;
        }
        wide = pc.physical > 0.5 ? min(open / 6.0, 1.0) : mix(1.0, max(open / 6.0, 0.2), pc.ambient);
        // (the game scales its point lights by this image too, the fairy's, not only its ambient light (its spots it
        // does not): an image near zero in a cave put the fairy's light out, and a frame of the game's own occlusion
        // was a flash of it. So where a point light gives p times the sky's light the image is (wide + p) / (1 + p):
        // the ambient scaled by wide and the light whole)
        if (pc.physical > 0.5 && pc.sky > 0.0) {
            float p = 0.0;
            for (int k = 0; k < pc.light_count; k++) {
                Floats lb = Floats(pc.light_list);
                const uint o = uint(k) * 20u;
                if (lb.f[o + 11u] > 0.5) continue;
                const vec3 to = vec3(lb.f[o], lb.f[o + 1u], lb.f[o + 2u]) - from;
                p += dot(vec3(lb.f[o + 4u], lb.f[o + 5u], lb.f[o + 6u]), vec3(0.2126, 0.7152, 0.0722)) * lamp_fall(o, from) *
                     max(dot(n, to / max(length(to), 1e-4)), 0.0) / pc.sky;
            }
            wide = (wide + p) / (1.0 + p);
        }
    }
    imageStore(occlusion, g, vec4(clamp((1.0 - pc.strength * sum / float(max(pc.rays, 1))) * wide, 0.0, 1.0)));
}
